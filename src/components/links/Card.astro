---
import { Icon } from "astro-icon/components";

const { keyName, link, index } = Astro.props;

const tint = link?.hex || null;
---

<a
  href={`https://rhgdev.in/@${keyName}`}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative overflow-hidden flex items-center gap-5 p-5 rounded-2xl
         backdrop-blur-md border
         transition-all duration-300
         hover:-translate-y-1 hover:shadow-xl
         animate-fade-in opacity-0"
  style={`
    animation-delay: ${500 + index * 100}ms;
    animation-fill-mode: forwards;
    ${
      tint
        ? `
      background: ${tint}15;
      border-color: ${tint}40;
    `
        : `
      background: rgba(0,0,0,0.15);
      border-color: rgba(255,255,255,0.1);
    `
    }
  `}
>
  <!-- Watermark Icon (background) -->
  <div
    class="absolute -bottom-6 -right-6 pointer-events-none select-none opacity-5 rotate-12
         transition-all duration-500 ease-out
         group-hover:scale-125 group-hover:opacity-20 group-hover:rotate-25"
  >
    <Icon
      name={link.astroicon}
      class="text-[140px]"
      style={tint ? `color: ${tint};` : "color: white;"}
    />
  </div>

  <!-- Icon -->
  <div
    class="relative w-14 h-14 shrink-0 rounded-xl flex items-center justify-center"
    style={tint
      ? `background: ${tint}25;`
      : "background: rgba(255,255,255,0.05);"}
  >
    <Icon
      name={link.astroicon}
      class="text-2xl transition scale-150"
      style={tint ? `color: ${tint};` : "color: rgba(255,255,255,0.7);"}
    />
  </div>

  <!-- Content -->
  <div class="flex-1 space-y-1 relative z-10">
    <h3
      class="text-2xl font-bold text-gray-100 group-hover:text-white transition"
    >
      {link.title}
    </h3>

    <!-- <p class="text-xs text-gray-400 font-mono">
      @{keyName}
    </p> -->
  </div>
</a>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }
</style>
